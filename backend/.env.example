# Copy to `.env` and adjust for your environment.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for local SQLite. Production example:
# DATABASE_URL=postgres://agency:password@localhost:5432/agency
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=

# Rate limit for public proposal/audit form submissions (per IP).
LEAD_THROTTLE_RATE=20/hour
